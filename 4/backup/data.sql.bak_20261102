(5, 0, 'SHENGDI', '圣地秘境', 1, '🏞', '#e09bff', '承载红线与前世记忆的地方',       20, 1),
(8, 0, 'FABAO',   '法宝器物', 1, '🪭', '#ffd479', '红娘行头与两界神兵',             30, 1),
