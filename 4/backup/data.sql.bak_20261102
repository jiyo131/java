(3,  1, 'RW_DAOMEN',   '道门修士',   2, '🗡', '#ffc2cf', '一气道盟与各大家族的修行者',     20, 1),
(4,  1, 'RW_YAOZU',    '妖族众生',   2, '🌸', '#ff5c7a', '散落两界、各有执念的妖',         30, 1),
(6,  5, 'SD_TUSHAN',   '涂山圣地',   2, '🌳', '#e09bff', '苦情树所在的涂山核心',           10, 1),
(7,  5, 'SD_AOLAI',    '傲来秘境',   2, '🌊', '#c9b6ff', '东海之上的傲来国',               20, 1),
(9,  8, 'FB_HONGNIANG', '红娘法器',  2, '🧵', '#ffd479', '牵线续缘所用的器物',             10, 1),
(10, 8, 'FB_SHENBING',  '神兵符箓',  2, '⚔', '#ffb84d', '两界闻名的兵器与符箓',           20, 1),
(12, 11, 'ZZ_TUSHAN',   '涂山势力',  2, '🏯', '#7fe7c9', '以涂山为核心的妖族盟约',         10, 1),
